+/**
+ * meta_workspace_activate:
+ * @workspace: a #MetaWorkspace
+ * @timestamp: timestamp for activation
+ *
+ * Switches to @workspace. This uses per-monitor workspace activation,
+ * switching only on the monitor where the cursor is located (or primary
+ * monitor as fallback).
+ *
+ * For the traditional global workspace activation (affects all monitors),
+ * use meta_workspace_activate_with_focus() directly.
+ */
 void
 meta_workspace_activate (MetaWorkspace *workspace,
                          guint32        timestamp)
 {
-  meta_workspace_activate_with_focus (workspace, NULL, timestamp);
+  MetaContext *context;
+  MetaBackend *backend;
+  MetaLogicalMonitor *current_monitor;
+  MetaMonitorManager *monitor_manager;
+
+  /* Check if per-monitor workspaces are enabled */
+  if (!meta_prefs_get_per_monitor_workspaces ())
+    {
+      /* Traditional global workspace activation */
+      meta_workspace_activate_with_focus (workspace, NULL, timestamp);
+      return;
+    }
+
+  /* Per-monitor workspace mode: determine which monitor to switch */
+  context = meta_display_get_context (workspace->display);
+  backend = meta_context_get_backend (context);
+  current_monitor = meta_backend_get_current_logical_monitor (backend);
+
+  /* Fallback to primary monitor if cursor position unavailable */
+  if (!current_monitor)
+    {
+      monitor_manager = meta_backend_get_monitor_manager (backend);
+      current_monitor = meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+    }
+
+  /* Use per-monitor activation if we have a valid monitor */
+  if (current_monitor)
+    {
+      meta_workspace_manager_activate_workspace_for_monitor (workspace->manager,
+                                                             workspace,
+                                                             current_monitor,
+                                                             timestamp);
+    }
+  else
+    {
+      /* Fallback to traditional global activation if no monitor found */
+      meta_workspace_activate_with_focus (workspace, NULL, timestamp);
+    }
 }
 
