+static void
+on_monitors_changed (MetaMonitorManager   *monitor_manager,
+                    MetaWorkspaceManager *workspace_manager)
+{
+  GList *logical_monitors, *l;
+  GHashTableIter iter;
+  gpointer key, value;
+  g_autoptr (GHashTable) old_monitors = NULL;
+
+  logical_monitors = meta_monitor_manager_get_logical_monitors (monitor_manager);
+
+  /* Save current monitor->workspace mappings before clearing */
+  old_monitors = g_hash_table_new (g_direct_hash, g_direct_equal);
+  g_hash_table_iter_init (&iter, workspace_manager->monitor_active_workspaces);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      MetaLogicalMonitor *monitor = key;
+
+      g_hash_table_insert (old_monitors,
+                           GINT_TO_POINTER (monitor->number),
+                           value);
+    }
+
+  /* Clear old mappings - monitors may have been removed */
+  g_hash_table_remove_all (workspace_manager->monitor_active_workspaces);
+
+  /* Restore mappings for monitors that still exist */
+  for (l = logical_monitors; l; l = l->next)
+    {
+      MetaLogicalMonitor *monitor = l->data;
+      MetaWorkspace *workspace;
+
+      /* Try to restore previous workspace for this monitor */
+      workspace = g_hash_table_lookup (old_monitors,
+                                       GINT_TO_POINTER (monitor->number));
+
+      if (!workspace)
+        {
+          /* New monitor - use the primary monitor's active workspace */
+          MetaLogicalMonitor *primary =
+            meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+          if (primary)
+            workspace = g_hash_table_lookup (old_monitors,
+                                             GINT_TO_POINTER (primary->number));
+          if (!workspace)
+            workspace = workspace_manager->active_workspace;
+        }
+
+      if (workspace)
+        {
+          g_hash_table_replace (workspace_manager->monitor_active_workspaces,
+                                g_object_ref (monitor),
+                                workspace);
+        }
+    }
+
+  /* Update work areas after monitor configuration changes */
+  meta_workspace_manager_reload_work_areas (workspace_manager);
+  for (l = workspace_manager->workspaces; l; l = l->next)
+    meta_workspace_queue_calc_showing (l->data);
+}
