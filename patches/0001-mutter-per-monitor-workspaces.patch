+/**
+ * meta_workspace_manager_activate_workspace_for_monitor:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @workspace: the #MetaWorkspace to activate
+ * @monitor: the #MetaLogicalMonitor to activate the workspace on
+ * @timestamp: timestamp for the activation
+ *
+ * Activates @workspace on the specified @monitor only.
+ * Other monitors remain on their current workspaces.
+ * This enables per-monitor independent workspace switching.
+ */
+void
+meta_workspace_manager_activate_workspace_for_monitor (MetaWorkspaceManager *workspace_manager,
+                                                       MetaWorkspace        *workspace,
+                                                       MetaLogicalMonitor   *monitor,
+                                                       guint32               timestamp)
+{
+  MetaWorkspace *old_workspace;
+  MetaWorkspace *old_global_workspace;
+  MetaContext *context;
+  MetaBackend *backend;
+  MetaMonitorManager *monitor_manager;
+  MetaLogicalMonitor *primary_monitor;
+  gboolean old_workspace_was_active;
+  gboolean workspace_was_active;
+  gboolean old_global_workspace_was_active;
+
+  g_return_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager));
+  g_return_if_fail (META_IS_WORKSPACE (workspace));
+  g_return_if_fail (monitor != NULL);
+
+  old_workspace = g_hash_table_lookup (workspace_manager->monitor_active_workspaces,
+                                       monitor);
+  old_global_workspace = workspace_manager->active_workspace;
+
+  old_workspace_was_active = old_workspace &&
+    meta_workspace_manager_is_workspace_active (workspace_manager, old_workspace);
+  workspace_was_active =
+    meta_workspace_manager_is_workspace_active (workspace_manager, workspace);
+  old_global_workspace_was_active = old_global_workspace &&
+    meta_workspace_manager_is_workspace_active (workspace_manager,
+                                                old_global_workspace);
+
+  if (old_workspace == workspace)
+    return;  /* Already active on this monitor */
+
+  /* Update the hash table */
+  g_hash_table_replace (workspace_manager->monitor_active_workspaces,
+                        g_object_ref (monitor),
+                        workspace);
+
+  /* Update global active_workspace if this is the primary monitor */
+  context = meta_display_get_context (workspace_manager->display);
+  backend = meta_context_get_backend (context);
+  monitor_manager = meta_backend_get_monitor_manager (backend);
+  primary_monitor = meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+
+  if (monitor == primary_monitor || !workspace_manager->active_workspace)
+    {
+      workspace_manager->active_workspace = workspace;
+      if (old_global_workspace != workspace)
+        {
+          g_signal_emit (workspace_manager,
+                         workspace_manager_signals[ACTIVE_WORKSPACE_CHANGED],
+                         0);
+        }
+    }
+
+  if (old_workspace &&
+      old_workspace_was_active !=
+      meta_workspace_manager_is_workspace_active (workspace_manager,
+                                                  old_workspace))
+    g_object_notify (G_OBJECT (old_workspace), "active");
+
+  if (workspace_was_active !=
+      meta_workspace_manager_is_workspace_active (workspace_manager, workspace))
+    g_object_notify (G_OBJECT (workspace), "active");
+
+  if (old_global_workspace &&
+      old_global_workspace != old_workspace &&
+      old_global_workspace != workspace &&
+      old_global_workspace_was_active !=
+      meta_workspace_manager_is_workspace_active (workspace_manager,
+                                                  old_global_workspace))
+    g_object_notify (G_OBJECT (old_global_workspace), "active");
+
+  workspace_manager->switch_monitor_index = monitor->number;
+
+  /* Queue calc_showing for windows on both old and new workspaces */
+  if (old_workspace)
+    meta_workspace_queue_calc_showing (old_workspace);
+  meta_workspace_queue_calc_showing (workspace);
+
+  /* Emit the per-monitor workspace changed signal */
+  g_signal_emit (workspace_manager,
+                workspace_manager_signals[MONITOR_WORKSPACE_CHANGED],
+                0,
+                monitor,
+                old_workspace,
+                workspace);
+
+  if (old_workspace)
+    {
+      MetaCompositor *compositor =
+        meta_display_get_compositor (workspace_manager->display);
+      int from = meta_workspace_index (old_workspace);
+      int to = meta_workspace_index (workspace);
+      MetaMotionDirection direction = to >= from ? META_MOTION_RIGHT : META_MOTION_LEFT;
+
+      if (meta_prefs_get_dynamic_workspaces () &&
+          to == meta_workspace_manager_get_n_workspaces (workspace_manager) - 1)
+        meta_workspace_manager_append_new_workspace (workspace_manager, FALSE, timestamp);
+
+      meta_compositor_switch_workspace (compositor, old_workspace, workspace, direction);
+      meta_workspace_manager_workspace_switched (workspace_manager, from, to, direction);
+    }
+
+  meta_workspace_focus_default_window (workspace, NULL, timestamp);
+
+  if (!old_workspace && meta_prefs_get_dynamic_workspaces () &&
+      meta_workspace_index (workspace) ==
+      meta_workspace_manager_get_n_workspaces (workspace_manager) - 1)
+    meta_workspace_manager_append_new_workspace (workspace_manager, FALSE, timestamp);
+
+  meta_topic (META_DEBUG_WORKAREA,
+              "Activated workspace %d on monitor %p (was %d)",
+              meta_workspace_index (workspace),
+              monitor,
+              old_workspace ? meta_workspace_index (old_workspace) : -1);
+}
+
+/**
+ * meta_workspace_manager_get_active_workspace_for_monitor:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @monitor: the #MetaLogicalMonitor to query
+ *
+ * Gets the currently active workspace on the specified monitor.
+ *
+ * Return value: (transfer none) (nullable): the active workspace on @monitor,
+ *   or %NULL if no workspace is active on that monitor yet.
+ */
+MetaWorkspace *
+meta_workspace_manager_get_active_workspace_for_monitor (MetaWorkspaceManager *workspace_manager,
+                                                         MetaLogicalMonitor   *monitor)
+{
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+  g_return_val_if_fail (monitor != NULL, NULL);
+
+  return g_hash_table_lookup (workspace_manager->monitor_active_workspaces,
+                             monitor);
+}
+
+/**
+ * meta_workspace_manager_get_active_workspace_for_monitor_index:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @monitor_index: logical monitor number
+ *
+ * Gets the active workspace for a monitor by its current logical monitor number.
+ *
+ * Returns: (transfer none) (nullable): the active workspace, if available
+ */
+MetaWorkspace *
+meta_workspace_manager_get_active_workspace_for_monitor_index (MetaWorkspaceManager *workspace_manager,
+                                                               int                   monitor_index)
+{
+  MetaContext *context;
+  MetaBackend *backend;
+  MetaMonitorManager *monitor_manager;
+  MetaLogicalMonitor *monitor;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+
+  context = meta_display_get_context (workspace_manager->display);
+  backend = meta_context_get_backend (context);
+  monitor_manager = meta_backend_get_monitor_manager (backend);
+  monitor = meta_monitor_manager_get_logical_monitor_from_number (monitor_manager,
+                                                                  monitor_index);
+  return monitor
+    ? meta_workspace_manager_get_active_workspace_for_monitor (workspace_manager, monitor)
+    : workspace_manager->active_workspace;
+}
+
+void
+meta_workspace_manager_activate_workspace_for_monitor_index (MetaWorkspaceManager *workspace_manager,
+                                                             MetaWorkspace        *workspace,
+                                                             int                   monitor_index,
+                                                             guint32               timestamp)
+{
+  MetaContext *context;
+  MetaBackend *backend;
+  MetaMonitorManager *monitor_manager;
+  MetaLogicalMonitor *monitor;
+
+  g_return_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager));
+  g_return_if_fail (META_IS_WORKSPACE (workspace));
+
+  context = meta_display_get_context (workspace_manager->display);
+  backend = meta_context_get_backend (context);
+  monitor_manager = meta_backend_get_monitor_manager (backend);
+  monitor = meta_monitor_manager_get_logical_monitor_from_number (monitor_manager,
+                                                                  monitor_index);
+  if (monitor)
+    meta_workspace_manager_activate_workspace_for_monitor (workspace_manager,
+                                                           workspace,
+                                                           monitor,
+                                                           timestamp);
+}
+
+int
+meta_workspace_manager_get_switch_monitor_index (MetaWorkspaceManager *workspace_manager)
+{
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), -1);
+
+  return workspace_manager->switch_monitor_index;
+}
+
+/**
+ * meta_workspace_manager_get_monitors_for_workspace:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @workspace: the #MetaWorkspace to query
+ *
+ * Gets the list of monitors that currently have @workspace active.
+ *
+ * Return value: (transfer full) (element-type MetaLogicalMonitor): a list
+ *   of monitors showing @workspace. Free with g_list_free().
+ */
+GList *
+meta_workspace_manager_get_monitors_for_workspace (MetaWorkspaceManager *workspace_manager,
+                                                   MetaWorkspace        *workspace)
+{
+  GHashTableIter iter;
+  gpointer key, value;
+  GList *monitors = NULL;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+  g_return_val_if_fail (META_IS_WORKSPACE (workspace), NULL);
+
+  g_hash_table_iter_init (&iter, workspace_manager->monitor_active_workspaces);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      if (value == workspace)
+        monitors = g_list_prepend (monitors, key);
+    }
+
+  return monitors;
+}
+
+gboolean
+meta_workspace_manager_is_workspace_active (MetaWorkspaceManager *workspace_manager,
+                                            MetaWorkspace        *workspace)
+{
+  GHashTableIter iter;
+  gpointer value;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), FALSE);
+  g_return_val_if_fail (META_IS_WORKSPACE (workspace), FALSE);
+
+  if (workspace_manager->active_workspace == workspace)
+    return TRUE;
+
+  g_hash_table_iter_init (&iter, workspace_manager->monitor_active_workspaces);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      if (value == workspace)
+        return TRUE;
+    }
+
+  return FALSE;
